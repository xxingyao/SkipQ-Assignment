// ============================================================================
//  Jenkinsfile — Question 4(b) SCAFFOLD: the CI/CD release pipeline.
//  One Multibranch pipeline: the 4(a) test gate on every push, and the tagged
//  deploy on merge to `main`.
// ============================================================================
// YOU FILL: replace each REPLACE_WITH_... below, guided by the inline hints
//           (search the file for `REPLACE_WITH` to find every blank).
//
// PROVIDED (do not write): the pipeline skeleton, the Checkout stage, and the
// two 4(a) test stages — they run the test harness you completed in Question
// 4(a) as-is. Your work is the environment values and the three deploy stages.

pipeline {
  agent any

  environment {
    // PROVIDED shape — set the two bucket/host values from your Question 2
    // terraform outputs (or as Jenkins job env vars).
    SITE_BUCKET    = 'ict381-eca-site-xxingyao-203635632743'          // Q2 site_s3_bucket_name
    APP_PUBLIC_DNS = 'ec2-3-214-100-242.compute-1.amazonaws.com'  // Q2 application_host_public_dns
    AWS_REGION     = 'us-east-1'                                 // PROVIDED — Q2 pins us-east-1
    // A version generated by the MACHINE, not a human — derive it from the
    // Jenkins build number so every release is labelled automatically.
    RELEASE_TAG    = "v${BUILD_NUMBER}"
  }

  stages {

    // -- PROVIDED: single monorepo checkout (also sets env.BRANCH_NAME) --------
    stage('Checkout') { steps { checkout scm } }

    // ---- Test gate (Question 4a) — PROVIDED, runs on EVERY push -------------
    stage('Frontend tests') {
      steps {
        dir('frontend') {
          sh 'docker run --rm -v "$PWD:/app" -w /app node:16.20.2-alpine sh -c "npm ci && CI=true npm test"'
        }
      }
    }
    stage('Backend tests') {
      steps {
        dir('backend') {
          sh 'docker compose -f test-compose.yml up --build --abort-on-container-exit --exit-code-from test'
        }
      }
      post { always { dir('backend') { sh 'docker compose -f test-compose.yml down -v' } } }
    }

    // ---- Deploy (Question 4b) ----------------------------------------------
    // The test stages above are UNGUARDED (they run on every branch). GUARD
    // EACH deploy stage below so it runs ONLY on the `main` build — otherwise a
    // feature-branch push would ship work-in-progress code.

    stage('Tag release') {
      when { branch 'main' }                       // run this stage only on the main build
      steps {
        // `git push` is an OUTBOUND write to GitHub — wrap it with the SSH push
        // credential (the same one the checkout uses; the webhook does not grant push).
        sshagent(['github-ssh-key']) {
          sh 'git tag ${RELEASE_TAG} && git push origin ${RELEASE_TAG}'             // tag the commit with RELEASE_TAG, then push the tag
        }
      }
    }

    stage('Deploy frontend to S3') {
      when { branch 'main' }
      steps {
        dir('frontend') {
          // PROVIDED — build in the node:16.20.2-alpine container with the API base
          // baked in (react-scripts inlines REACT_APP_* at build time → the site calls
          // APP_PUBLIC_DNS). See the Question 4(b) README question on this command.
          sh '''docker run --rm -e REACT_APP_API_URL=http://${APP_PUBLIC_DNS}:5000 \
                 -v "$PWD:/app" -w /app node:16.20.2-alpine sh -c "npm ci && npm run build"'''
          // Publish on the HOST via the instance profile (no static keys); remove
          // files that are no longer in the build from the bucket too. Reference:
          // https://docs.aws.amazon.com/cli/latest/reference/s3/sync.html
          sh 'aws s3 sync build/ s3://${SITE_BUCKET} --delete --region ${AWS_REGION}'
        }
      }
    }

    stage('Deploy backend to app host') {
      when { branch 'main' }
      steps {
        dir('infra/ansible') {
          // Build + push the immutable backend :vN image to ECR — reuse the
          // Question 3(b) playbook, handing it RELEASE_TAG as the image tag.
          sh 'ansible-playbook build-docker.yaml -e backend_repo=203635632743.dkr.ecr.us-east-1.amazonaws.com/ict381_backend -e mongo_repo=203635632743.dkr.ecr.us-east-1.amazonaws.com/ict381_mongo -e image_tag=${RELEASE_TAG}'
          // Deploy that same immutable tag to both tiers — reuse the Question 3(b)
          // deploy playbook, handing RELEASE_TAG as BOTH the backend image tag and
          // the mongo image tag (-e image_tag=... -e mongo_image_tag=...).
          sh 'ansible-playbook prod-application.yaml -e image_tag=${RELEASE_TAG} -e mongo_image_tag=${RELEASE_TAG}'
        }
      }
    }
  }
}
